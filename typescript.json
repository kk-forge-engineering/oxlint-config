{
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["./dist/plugin.js"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "rules": {
    // A native dialog blocks the page and cannot be styled or tested: a library's window replaces it.
    "eslint/no-alert": "error",
    // A string of HTML would run in the page, so the text goes in as nodes. no-alert reads window and globalThis, and
    // self names the same global object, so its dialogs are listed here. oxlint prints no message of its own for these.
    "eslint/no-restricted-properties": [
      "error",
      { "property": "innerHTML" },
      { "property": "outerHTML" },
      { "property": "insertAdjacentHTML" },
      { "object": "self", "property": "alert" },
      { "object": "self", "property": "confirm" },
      { "object": "self", "property": "prompt" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-misused-promises": "error",
    "prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
    "no-var": "error",
    "import/no-cycle": "error",
    "no-unmodified-loop-condition": "error",
    "no-unexpected-multiline": "error",
    "no-extend-native": "error",
    "preserve-caught-error": "error",
    "oxc/misrefactored-assign-op": "error",
    "unicorn/require-post-message-target-origin": "error",
    "unicorn/no-accessor-recursion": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-enum-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-extraneous-class": "error",
    "import/no-named-as-default-member": "error",
    // == null is the one loose comparison kept: it tests for both null and undefined, which DOM APIs return.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "curly": ["error", "all"],
    // code-style.md splits a file past about 450 lines. Blank lines and comments carry no logic, so they do not count.
    "max-lines": ["error", { "max": 450, "skipBlankLines": true, "skipComments": true }],
    "no-console": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "kk-forge/no-index-files": "error"
  },
  "overrides": [
    {
      // A test is not the program, so it may print, as core.md exempts it from the environment rules. A string of HTML
      // it sets up runs in no page a user sees, so it may set HTML from a string. A native dialog stays banned in a test.
      // oxlint replaces the base options with this list rather than merging them, so the list repeats the base list
      // without its HTML entries, and test/configs.test.ts checks that the two match.
      "files": ["**/*.test.*", "**/*.spec.*", "**/tests/**"],
      "rules": {
        "no-console": "off",
        "eslint/no-restricted-properties": [
          "error",
          { "object": "self", "property": "alert" },
          { "object": "self", "property": "confirm" },
          { "object": "self", "property": "prompt" }
        ]
      }
    },
    {
      // Only infra writes output, a feature's infra/ included, so only infra calls the console. core.md vendors the
      // console sink into src/infra/logger.
      "files": ["**/src/infra/**", "**/src/features/*/infra/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // A declaration file imports a module bare to augment that module's types, and the import runs no code.
      "files": ["**/*.d.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
