{
  "plugins": ["jsx-a11y"],
  "jsPlugins": ["eslint-plugin-solid", "./dist/plugin.js"],
  "rules": {
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": "error",
    "solid/jsx-uses-vars": "error",
    "solid/no-unknown-namespaces": "error",
    "solid/no-innerhtml": "error",
    "solid/jsx-no-script-url": "error",
    "solid/components-return-once": "error",
    "solid/no-destructure": "error",
    "solid/prefer-for": "error",
    "kk-forge/no-conditional-map": "error",
    "solid/reactivity": "error",
    "solid/event-handlers": "error",
    "solid/imports": "error",
    "solid/style-prop": "error",
    "solid/no-react-deps": "error",
    "solid/no-react-specific-props": "error",
    "solid/self-closing-comp": "error",
    "solid/validate-jsx-nesting": "error",
    "solid/no-unused-signal": "error",
    "solid/no-accessor-as-prop": "error",
    "solid/no-module-scope-reactive-primitive": "error",
    // solid/no-unassigned-vars replaces it: Solid assigns `let ref` through the JSX ref attribute, which only the
    // Solid rule sees.
    "no-unassigned-vars": "off",
    "solid/no-unassigned-vars": "error",
    // Both rules look 2 levels deep by default: for a control's or a label's text, and the label rule also for its
    // nested control. Solid's <Show> and <For> each put a level in between, so text two of them deep read as
    // missing. Depth 4 sees through them and still reports a control or label with no text at all.
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 4 }],
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 4 }]
  }
}
